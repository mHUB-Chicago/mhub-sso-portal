CORS_ORIGIN="http://localhost:5173"
DOMAIN="localhost:5173"
BACKEND_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:5173"
PEOPLEVINE_ADMIN_PASSWORD="your_peoplevine_admin_password"
PEOPLEVINE_ADMIN_USERNAME="your_peoplevine_admin_username"
PEOPLEVINE_COMPANY_ID="your_peoplevine_company_id"
# Any existing, synced PV customer id — used as the on-behalf-of anchor when looking up
# PV's fixed-choice attribute option lists (schools, degrees, pronouns, etc.).
PEOPLEVINE_ATTRIBUTE_REFERENCE_CUSTOMER_ID="your_peoplevine_reference_customer_id"
# Gates the write-capable PV client (register/cart/checkout/attach-member) used by the
# onboarding "approve" action. Leave unset/false — only set to "true" when you're ready
# to test a real push to PeopleVine.
# PEOPLEVINE_WRITE_ENABLED="true"
# Shared secret PeopleVine must send back (as ?secret= or x-webhook-secret header) on
# every inbound webhook to /webhook/peoplevine. Leave unset locally; must be set in
# production or the endpoint accepts unauthenticated requests.
# WEBHOOK_SECRET="your_webhook_shared_secret"
# PV survey id for the combined payment + agreement/terms form (see
# peopleVineWebhookController.ts). Defaults to 20611 if unset.
# PEOPLEVINE_ONBOARDING_SURVEY_ID="20611"
# Member-facing URL for that same form, emailed to new members after their PV customer
# record is created (see onboardingController.ts). Defaults if unset.
# ONBOARDING_PAYMENT_FORM_URL="https://member.mhubchicago.com/form/20611"
SAML_ENTITY_ID="https://example.com/"
SAML_PRIVATE_KEY="your_saml_private_key"
SAML_PUBLIC_CERT="your_saml_public_certificate"
SENDGRID_API_KEY="your_sendgrid_api_key"
SENDGRID_BASE_TEMPLATE_ID="your_sendgrid_base_template_id"
SENDGRID_EMAIL_FROM="your_sendgrid_email_from"
SEED_ENABLED="true"
SEED_TOKEN="example_seed_token"