generator client {
  provider = "prisma-client-js"
  output   = "./models"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  USER
  ADMIN
}

enum SamlBinding {
  HTTP_REDIRECT
  HTTP_POST
}

enum SamlSignTarget {
  ASSERTION
  RESPONSE
  BOTH
}

enum PeopleVineTokenType {
  USER_COMPANY
  USER
}

model Company {
  id                      String                   @id @default(uuid())
  peopleVineId            String?                  @unique
  active                  Boolean                  @default(true)
  name                    String
  email                   String                   @unique
  membershipTypes         String                   @default("[]")
  isPersonal              Boolean                  @default(false)
  users                   User[]
  companyServiceProviders CompanyServiceProvider[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model User {
  id                   String                @id @default(uuid())
  peopleVineId         String?               @unique
  active               Boolean               @default(true)
  name                 String
  email                String                @unique
  username             String?               @unique
  passwordHashed       String?
  role                 Role
  companyId            String
  company              Company               @relation(fields: [companyId], references: [id])
  emailVerified        Boolean               @default(false)
  mustResetPassword    Boolean               @default(false)
  lastLogin            DateTime?
  membershipType       String?
  profilePhoto         String?
  phone                String?
  address              String?
  city                 String?
  state                String?
  zipCode              String?
  cardStatus           String?
  memberSource         String                @default("subscription")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  userServiceProviders UserServiceProvider[]
  samlAuthRequests     SamlAuthRequest[]
  sessions             Session[]
  loginRequests        LoginRequest[]
}

model LoginRequest {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptsCount      Int       @default(0)
  otpHashed          String?
  otpVerifiedAt      DateTime?
  passwordVerifiedAt DateTime?
  expiresAt          DateTime
  createdAt          DateTime  @default(now())

  @@index([userId, expiresAt])
}

model ServiceProvider {
  id               String                   @id @default(uuid())
  name             String
  logo             String
  entityId         String                   @unique
  acsUrl           String
  loginUrl         String
  signTarget       SamlSignTarget           @default(ASSERTION)
  autoRedirect     Boolean                  @default(false)
  active           Boolean                  @default(true)
  users            UserServiceProvider[]
  companies        CompanyServiceProvider[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  samlAuthRequests SamlAuthRequest[]
}

model UserServiceProvider {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceProviderId String
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)
  enabled           Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([userId, serviceProviderId])
}

model CompanyServiceProvider {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceProviderId String
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)
  enabled           Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([companyId, serviceProviderId])
}

model SamlAuthRequest {
  id                String          @id @default(uuid())
  serviceProviderId String
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id])
  userId            String?
  user              User?           @relation(fields: [userId], references: [id])
  inResponseTo      String
  acsUrl            String
  relayState        String?
  requestBinding    SamlBinding     @default(HTTP_REDIRECT)
  responseBinding   SamlBinding     @default(HTTP_POST)
  expiresAt         DateTime
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([serviceProviderId, inResponseTo])
}

model Session {
  id        String    @id @default(uuid())
  sessionId String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model PeopleVineToken {
  id           String              @id @default(uuid())
  tokenType    PeopleVineTokenType
  accessToken  String
  refreshToken String
  createdAt    DateTime            @default(now())
  expiresAt    DateTime
  updatedAt    DateTime            @updatedAt
}

model SyncSession {
  id          String    @id @default(uuid())
  type        String
  status      String    @default("pending")
  step        String    @default("")
  progress    Int       @default(0)
  logs        String    @default("[]")
  metadata    String    @default("{}")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

model WebhookLog {
  id         String   @id @default(uuid())
  source     String   @default("peoplevine")
  customerNo Int?
  eventType  String?
  payload    String?
  status     String   @default("received")
  diff       String?
  receivedAt DateTime @default(now())
}

model CompanyMembershipType {
  name      String   @id
  createdAt DateTime @default(now())
}

model PortalAccessType {
  name      String   @id
  createdAt DateTime @default(now())
}
