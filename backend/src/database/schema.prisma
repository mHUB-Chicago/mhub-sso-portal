generator client {
  provider = "prisma-client-js"
  output   = "./models"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  USER
  ADMIN
}

enum SamlBinding {
  HTTP_REDIRECT
  HTTP_POST
}

enum SamlSignTarget {
  ASSERTION
  RESPONSE
  BOTH
}

enum PeopleVineTokenType {
  USER_COMPANY
  USER
}

model Company {
  id           String   @id @default(uuid())
  peopleVineId String?  @unique
  active       Boolean  @default(true)
  name         String
  users        User[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id                   String                @id @default(uuid())
  peopleVineId         String?               @unique
  name                 String
  email                String                @unique
  passwordHashed       String?
  role                 Role
  companyId            String
  company              Company               @relation(fields: [companyId], references: [id])
  emailVerified        Boolean               @default(false)
  mustResetPassword    Boolean               @default(false)
  lastLogin            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  userServiceProviders UserServiceProvider[]
  samlAuthRequests     SamlAuthRequest[]
  sessions             Session[]
  loginRequests        LoginRequest[]
}

model LoginRequest {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptsCount Int       @default(0)
  otpHashed     String?
  otpVerifiedAt DateTime?
  passwordVerifiedAt DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@index([userId, expiresAt])
}

model ServiceProvider {
  id               String                @id @default(uuid())
  name             String
  entityId         String                @unique
  acsUrl           String
  nameIdFormat     String?
  nameIdSource     String                @default("email")
  signTarget       SamlSignTarget        @default(ASSERTION)
  active           Boolean               @default(true)
  users            UserServiceProvider[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  samlAuthRequests SamlAuthRequest[]
}

model UserServiceProvider {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceProviderId String
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)
  enabled           Boolean         @default(true)
  revokedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([userId, serviceProviderId])
}

model SamlAuthRequest {
  id                String          @id @default(uuid())
  serviceProviderId String
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id])
  userId            String?
  user              User?           @relation(fields: [userId], references: [id])
  inResponseTo      String
  acsUrl            String
  relayState        String?
  requestBinding    SamlBinding     @default(HTTP_REDIRECT)
  responseBinding   SamlBinding     @default(HTTP_POST)
  expiresAt         DateTime
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([serviceProviderId, inResponseTo])
}

model Session {
  id        String    @id @default(uuid())
  sessionId String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model PeopleVineToken {
  id           String              @id @default(uuid())
  tokenType    PeopleVineTokenType
  accessToken  String
  refreshToken String
  createdAt    DateTime            @default(now())
  expiresAt    DateTime
  updatedAt    DateTime            @updatedAt
}
