{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mhub-sso-portal",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-16",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "routes": [
    {
      "pattern": "auth.portal.mhub.org",
      "zone_name": "mhub.org",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mhub-sso-portal",
      "database_id": "64276139-5ee2-46f8-bb70-7e407d609cc4"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "QUEUE",
        "queue": "mhub-sso-portal"
      }
    ],
    "consumers": [
      {
        "queue": "mhub-sso-portal",
        "max_retries": 3,
        "max_concurrency": 5
      }
    ]
  },
  "triggers": {
    // Midnight America/Chicago: 05:00 UTC during CDT, 06:00 UTC during CST.
    // scheduledHandler picks whichever matches the current Chicago offset.
    "crons": ["0 5 * * *", "0 6 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
}

