{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mhub-sso-portal",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-16",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mhub-sso-portal",
      // "database_id": "45184088-9093-4aa3-b142-0590acad4c9a", // axsmodern
      "database_id": "64276139-5ee2-46f8-bb70-7e407d609cc4" // mhub-chicago
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "QUEUE",
        "queue": "mhub-sso-portal"
      }
    ],
    "consumers": [
      {
        "queue": "mhub-sso-portal"
      }
    ]
  },
  "triggers": {
    "crons": ["0 6 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "limits": {
    "cpu_ms": 300000
  },
}
